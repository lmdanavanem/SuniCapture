<Window x:Class="SuniCapture.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:SuniCapture.Localization" xmlns:editor="clr-namespace:SuniCapture.Editor" Title="SuniCapture" Width="1440" Height="940" MinWidth="1100" MinHeight="700" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnFileDrop" DragOver="OnDragOver" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
 <Grid Background="{DynamicResource ChromeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="66"/><RowDefinition/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
   <Grid Margin="24,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="Brand/sunicapture-icon.png" Width="43" Height="43" Stretch="Uniform" Margin="-5,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"/>
     <TextBlock FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"><Run Text="Suni"/><Run Text="{loc:Tr capture.name}" Foreground="#EF3438"/></TextBlock>
     <Border Background="{DynamicResource HoverBrush}" CornerRadius="4" Padding="6,2" Margin="10,1,0,0" VerticalAlignment="Center"><TextBlock x:Name="VersionLabel" Text="0.4.1" FontSize="10" Style="{StaticResource Muted}"/></Border>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0"><Ellipse Fill="{DynamicResource GreenBrush}" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock Text="{loc:Tr header.local}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
     <Button Content="{loc:Tr action.import}" ToolTip="{loc:Tr action.importHint}" Click="OnImport" Margin="0,0,8,0"/>
     <Button Content="{loc:Tr action.paste}" ToolTip="{loc:Tr action.pasteHint}" Click="OnPaste" Margin="0,0,12,0"/>
     <Button x:Name="LanguageButton" Style="{StaticResource QuietButton}" Click="OnLanguageMenu" ToolTip="{loc:Tr language.choose}" AutomationProperties.Name="{loc:Tr language.choose}" Padding="8" Margin="0,0,3,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" Style="{StaticResource Glyph}"/><TextBlock x:Name="LanguageLabel" Text="FR" Margin="5,0,0,0" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
     <Button x:Name="AboutButton" Style="{StaticResource QuietButton}" Click="OnAbout" ToolTip="{loc:Tr about.title}" AutomationProperties.Name="{loc:Tr about.title}" Width="38" Padding="8"><TextBlock Text="?" FontSize="21"/></Button>
     <Button x:Name="ThemeButton" Style="{StaticResource QuietButton}" Click="OnTheme" ToolTip="{loc:Tr theme.change}" Width="38" Padding="8"><TextBlock Text="&#xE708;" Style="{StaticResource Glyph}"/></Button>
     <Button x:Name="SettingsButton" Style="{StaticResource QuietButton}" Click="OnSettings" ToolTip="{loc:Tr settings.hint}" AutomationProperties.Name="{loc:Tr settings.hint}" Width="38" Padding="8"><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
   <Grid Margin="20,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="CaptureButton" Style="{StaticResource PrimaryButton}" Click="OnCaptureRegion" Padding="16,8" ToolTip="{loc:Tr capture.regionHint}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7A8;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="White" Margin="0,0,9,0"/><TextBlock Text="{loc:Tr capture.region}" Foreground="White"/><TextBlock Text="{loc:Tr shortcut.region}" Foreground="#CBDBFF" FontSize="11" Margin="18,2,0,0"/></StackPanel></Button>
    <Button Grid.Column="1" Click="OnCaptureScreen" Margin="9,0,0,0" ToolTip="{loc:Tr capture.screenHint}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="{loc:Tr capture.screen}"/></StackPanel></Button>
    <Button Grid.Column="2" Click="OnCaptureWindow" Margin="9,0,0,0" ToolTip="{loc:Tr capture.windowHint}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE737;" Style="{StaticResource Glyph}" Margin="0,0,8,0"/><TextBlock Text="{loc:Tr capture.window}"/></StackPanel></Button>
    <Button x:Name="RecordButton" Grid.Column="3" Click="OnRecord" Margin="9,0,0,0" ToolTip="{loc:Tr record.hint}" AutomationProperties.Name="{loc:Tr record.title}"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#DC2626" Margin="0,0,8,0"/><TextBlock x:Name="RecordLabel" Text="{loc:Tr record.title}"/></StackPanel></Button>
    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{loc:Tr capture.delay}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,9,0"/><ComboBox x:Name="DelayBox" Width="100" SelectionChanged="OnDelayChanged" AutomationProperties.Name="{loc:Tr capture.delayHint}"><ComboBoxItem Content="{loc:Tr delay.none}" Tag="0"/><ComboBoxItem Content="{loc:Tr delay.3}" Tag="3"/><ComboBoxItem Content="{loc:Tr delay.5}" Tag="5"/><ComboBoxItem Content="{loc:Tr delay.10}" Tag="10"/></ComboBox></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="265"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
    <Grid Margin="14,20,14,10">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="9,0,8,15"><TextBlock Text="{loc:Tr library.title}" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="CountLabel" HorizontalAlignment="Right" Style="{StaticResource Muted}" Text="0"/></Grid>
     <Grid Grid.Row="1" Margin="3,0,3,12"><TextBox x:Name="SearchBox" Height="36" ToolTip="{loc:Tr library.searchHint}" AutomationProperties.Name="{loc:Tr library.search}" TextChanged="OnSearch"/><TextBlock Text="{loc:Tr library.search}" FontSize="12" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <StackPanel Grid.Row="2">
      <Button x:Name="RecorderNavButton" Style="{StaticResource NavButton}" Click="OnOpenRecorder" ToolTip="{loc:Tr record.createHint}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="#DC2626" Margin="0,0,11,0"/><TextBlock Text="{loc:Tr record.title}" FontWeight="SemiBold"/></StackPanel></Button>
      <Button x:Name="AllFilterButton" Style="{StaticResource NavButton}" Click="OnFilter" Tag="all"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" Margin="0,0,11,0"/><TextBlock Text="{loc:Tr library.all}"/></StackPanel></Button>
      <Button x:Name="FavoriteFilterButton" Style="{StaticResource NavButton}" Click="OnFilter" Tag="favorite"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" Style="{StaticResource Glyph}" Margin="0,0,11,0"/><TextBlock Text="{loc:Tr library.favorites}"/></StackPanel></Button>
      <Button x:Name="VideoFilterButton" Style="{StaticResource NavButton}" Click="OnFilter" Tag="video"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" Style="{StaticResource Glyph}" Margin="0,0,11,0"/><TextBlock Text="{loc:Tr library.recordings}"/></StackPanel></Button>
      <Button x:Name="TrashFilterButton" Style="{StaticResource NavButton}" Click="OnFilter" Tag="trash"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" Margin="0,0,11,0"/><TextBlock Text="{loc:Tr library.trash}"/></StackPanel></Button>
     </StackPanel>
     <TextBlock x:Name="LibrarySectionLabel" Grid.Row="3" Text="{loc:Tr library.recent}" Style="{StaticResource Muted}" FontSize="11" Margin="11,22,0,9"/>
     <Grid Grid.Row="4">
      <ListBox x:Name="CaptureList" SelectionChanged="OnCaptureSelected" AutomationProperties.Name="{loc:Tr library.list}">
       <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="54" Height="44" CornerRadius="5" ClipToBounds="True" Background="{DynamicResource HoverBrush}"><Grid><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Margin="8,2,0,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="10" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding FavoriteMark}" Foreground="#D97706" Margin="5,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyLibraryLabel" Text="{loc:Tr library.empty}" Style="{StaticResource Muted}" FontSize="12" Margin="12,18" IsHitTestVisible="False"/>
     </Grid>
     <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="7,14,7,4"><StackPanel><TextBlock Text="{loc:Tr library.onComputer}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{loc:Tr library.originals}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,10"/><Button Content="{loc:Tr action.openFolder}" Click="OnOpenFolder" HorizontalContentAlignment="Left" FontSize="12"/></StackPanel></Border>
    </Grid>
   </Border>
   <Grid Grid.Column="1">
    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="38,34,38,28" MaxWidth="1120" HorizontalAlignment="Stretch">
      <Grid Margin="0,-12,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="Brand/sunicapture-logo.png" Width="124" Height="124" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0"><TextBlock Text="{loc:Tr home.welcome}" FontSize="27" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="{loc:Tr home.subtitle}" Style="{StaticResource Muted}" FontSize="15"/></StackPanel></Grid>
      <Button Style="{StaticResource PrimaryButton}" HorizontalContentAlignment="Stretch" Padding="24,22" Click="OnCaptureRegion"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="40" Height="40" Background="#407AFF" CornerRadius="10"><TextBlock Text="&#xE7A8;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{loc:Tr capture.region}" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{loc:Tr home.startHint}" Foreground="#E0EAFF" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="2" Text="{loc:Tr shortcut.region}" Foreground="#D6E3FF" VerticalAlignment="Center" Margin="15,0,0,0"/></Grid></Button>
      <TextBlock Text="{loc:Tr home.quick}" FontSize="17" FontWeight="SemiBold" Margin="0,30,0,17"/>
      <UniformGrid Columns="2" Rows="2" Margin="-6">
       <Button Margin="6" Padding="18" HorizontalContentAlignment="Stretch" Click="OnCaptureScreen"><StackPanel><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" FontSize="24" Margin="0,0,0,12"/><TextBlock Text="{loc:Tr home.screen}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{loc:Tr home.screenHint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,2"/></StackPanel></Button>
       <Button Margin="6" Padding="18" HorizontalContentAlignment="Stretch" Click="OnCaptureWindow"><StackPanel><TextBlock Text="&#xE737;" FontFamily="Segoe Fluent Icons" Foreground="#8B5CF6" FontSize="24" Margin="0,0,0,12"/><TextBlock Text="{loc:Tr home.window}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{loc:Tr home.windowHint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,2"/></StackPanel></Button>
       <Button Margin="6" Padding="18" HorizontalContentAlignment="Stretch" Click="OnOpenRecorder"><StackPanel><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" Foreground="#DC2626" FontSize="24" Margin="0,0,0,12"/><TextBlock Text="{loc:Tr record.title}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{loc:Tr home.recordHint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,2"/></StackPanel></Button>
       <Button Margin="6" Padding="18" HorizontalContentAlignment="Stretch" Click="OnImport"><StackPanel><TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons" Foreground="#159660" FontSize="24" Margin="0,0,0,12"/><TextBlock Text="{loc:Tr home.image}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{loc:Tr home.imageHint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,2"/></StackPanel></Button>
      </UniformGrid>
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,30,0,0" Padding="0,18,0,0"><TextBlock Text="{loc:Tr home.footer}" Style="{StaticResource Muted}" FontSize="12" LineHeight="21"/></Border>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="EditorView" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="59"/><RowDefinition Height="54"/><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
     <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="18,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ImageNameLabel" Text="{loc:Tr capture.name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ImageSourceLabel" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="FavoriteButton" Click="OnFavorite" Style="{StaticResource QuietButton}" Content="☆" FontSize="20" ToolTip="{loc:Tr favorite.add}" Width="36" Padding="5"/><Button Content="{loc:Tr action.rename}" Click="OnRename" Style="{StaticResource QuietButton}" Margin="5,0"/><Button x:Name="TrashButton" Content="{loc:Tr library.trash}" Click="OnTrash" Style="{StaticResource QuietButton}"/><Button Content="{loc:Tr action.home}" Click="OnHome" Style="{StaticResource QuietButton}" Margin="8,0,0,0"/></StackPanel></Grid>
     </Border>
     <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid Margin="12,7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="ToolBar" Orientation="Horizontal"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="UndoButton" Click="OnUndo" ToolTip="{loc:Tr edit.undo}" Padding="8" Margin="4,0" Content="↶" FontSize="19"/><Button x:Name="RedoButton" Click="OnRedo" ToolTip="{loc:Tr edit.redo}" Padding="8" Margin="4,0" Content="↷" FontSize="19"/></StackPanel></Grid></Border>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="225"/></Grid.ColumnDefinitions>
      <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CanvasBrush}" SizeChanged="OnCanvasSizeChanged"><Border Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center" Background="White"><Border.Effect><DropShadowEffect Color="#0F172A" BlurRadius="20" ShadowDepth="3" Opacity="0.12"/></Border.Effect><editor:AnnotationCanvas x:Name="Canvas" Changed="OnCanvasChanged" Focusable="True" AutomationProperties.Name="{loc:Tr edit.canvas}"><editor:AnnotationCanvas.LayoutTransform><ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/></editor:AnnotationCanvas.LayoutTransform></editor:AnnotationCanvas></Border></ScrollViewer>
      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18,20">
       <TextBlock Text="{loc:Tr edit.properties}" FontWeight="SemiBold" FontSize="14"/>
       <TextBlock x:Name="ToolNameLabel" Text="{loc:Tr tool.arrow}" Style="{StaticResource Muted}" Margin="0,6,0,22"/>
       <StackPanel x:Name="DrawingOptionsPanel"><TextBlock Text="{loc:Tr edit.color}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/><WrapPanel x:Name="ColorPalette" Margin="-3,0"/>
       <TextBox x:Name="HexColorBox" Text="#2563EB" ToolTip="{loc:Tr edit.hex}" AutomationProperties.Name="{loc:Tr edit.hex}" LostFocus="OnColorTyped" Margin="0,11,0,20"/>
       <StackPanel x:Name="StrokeOptionsPanel"><Grid><TextBlock Text="{loc:Tr edit.thickness}" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="StrokeLabel" Text="4 px" HorizontalAlignment="Right" Style="{StaticResource Muted}" FontSize="11"/></Grid><Slider x:Name="StrokeSlider" Minimum="1" Maximum="20" Value="4" ValueChanged="OnStrokeChanged" Margin="0,12,0,22" AutomationProperties.Name="{loc:Tr edit.stroke}"/></StackPanel></StackPanel>
       <StackPanel x:Name="TextOptionsPanel" Visibility="Collapsed"><TextBlock Text="{loc:Tr edit.textPlace}" FontSize="12" FontWeight="SemiBold"/><TextBox x:Name="AnnotationTextBox" Text="Votre texte" TextChanged="OnAnnotationTextChanged" Margin="0,10,0,12" AcceptsReturn="True" MinHeight="58" MaxHeight="120" TextWrapping="Wrap" AutomationProperties.Name="{loc:Tr edit.annotation}"/>
       <TextBlock Text="{loc:Tr edit.textSize}" FontSize="12"/><Slider x:Name="FontSlider" Minimum="12" Maximum="80" Value="28" ValueChanged="OnFontChanged" Margin="0,10,0,22" AutomationProperties.Name="{loc:Tr edit.textSize}"/></StackPanel>
       <Border Background="{DynamicResource ChromeBrush}" CornerRadius="7" Padding="11"><TextBlock x:Name="ToolHintLabel" Text="{loc:Tr tool.initialHint}" Style="{StaticResource Muted}" FontSize="11" LineHeight="18"/></Border>
      </StackPanel></ScrollViewer><Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,13,16,12"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SaveButton" Content="{loc:Tr action.save}" Click="OnSave" ToolTip="{loc:Tr edit.saveHint}" FontSize="11" Padding="5,7" Margin="0,0,4,0"/><Button Grid.Column="1" Content="{loc:Tr action.copy}" Click="OnCopy" Margin="4,0,0,0" ToolTip="{loc:Tr edit.copyHint}" FontSize="11" Padding="5,7"/></Grid><Button Click="OnExport" Margin="0,8,0,0" Style="{StaticResource PrimaryButton}" ToolTip="{loc:Tr edit.exportHint}"><TextBlock Text="{loc:Tr action.export}" Foreground="White"/></Button><Button Content="{loc:Tr edit.original}" Click="OnRestoreOriginal" Margin="0,6,0,0" Style="{StaticResource QuietButton}" FontSize="11" Padding="5,6"/></StackPanel></Border></Grid></Border>
     </Grid>
     <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"><Grid Margin="18,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ImageDimensionsLabel" Text="" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="11"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="−" Click="OnZoomOut" Padding="9,2"/><TextBlock x:Name="ZoomLabel" Text="100 %" Width="62" TextAlignment="Center" VerticalAlignment="Center" FontSize="11"/><Button Content="+" Click="OnZoomIn" Padding="9,2"/><Button Content="{loc:Tr edit.fit}" Click="OnFit" Padding="11,2" Margin="10,0,0,0"/></StackPanel></Grid></Border>
    </Grid>
    <ScrollViewer x:Name="RecorderView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="38,32" MaxWidth="850" HorizontalAlignment="Stretch">
      <TextBlock Text="{loc:Tr record.title}" FontSize="27" FontWeight="SemiBold"/>
      <TextBlock Text="{loc:Tr record.subtitle}" Style="{StaticResource Muted}" FontSize="14" Margin="0,10,0,28"/>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28">
       <StackPanel>
        <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="64" Height="64" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top"><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" Foreground="#DC2626" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="RecordingStateLabel" Text="{loc:Tr record.ready}" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RecordingElapsedLabel" Text="00:00:00" Foreground="{DynamicResource MutedBrush}" FontSize="29" Margin="0,6,0,0" FontFamily="Cascadia Mono, Consolas"/></StackPanel></Grid>
        <Border Background="{DynamicResource ChromeBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{loc:Tr record.primary}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{loc:Tr record.visibleHint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{loc:Tr record.format}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border>
        <CheckBox x:Name="RecordingAudioBox" Content="{loc:Tr record.audio}" Checked="OnRecordingAudioChanged" Unchecked="OnRecordingAudioChanged" ToolTip="{loc:Tr record.audioHint}" Margin="0,0,0,17"/>
        <TextBlock x:Name="RecordingHelpLabel" Text="{loc:Tr record.defaultHelp}" Style="{StaticResource Muted}" FontSize="12" LineHeight="20" Margin="0,0,0,24"/>
        <WrapPanel><Button x:Name="StartRecordingButton" Click="OnStartRecording" Background="#DC2626" BorderBrush="#DC2626" Padding="18,11" Margin="0,0,10,10" AutomationProperties.Name="{loc:Tr record.startName}"><StackPanel Orientation="Horizontal"><Ellipse Fill="White" Width="8" Height="8" Margin="0,0,10,0"/><TextBlock Text="{loc:Tr record.start}" Foreground="White" FontWeight="SemiBold"/></StackPanel></Button><Button x:Name="StopRecordingButton" Click="OnStopRecording" Padding="18,11" IsEnabled="False" Margin="0,0,0,10" Content="{loc:Tr record.stopSave}"/></WrapPanel>
        <TextBlock Text="{loc:Tr record.shortcut}" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
       </StackPanel>
      </Border>
      <Button Content="{loc:Tr record.show}" Click="OnShowRecordings" HorizontalAlignment="Left" Margin="0,20,0,0"/>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="VideoView" Visibility="Collapsed" Margin="38">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock x:Name="VideoNameLabel" FontWeight="SemiBold" FontSize="23"/><TextBlock x:Name="VideoInfoLabel" Style="{StaticResource Muted}" Margin="0,8,0,20"/></StackPanel>
     <Border Grid.Row="1" Background="Black" CornerRadius="10" ClipToBounds="True"><MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaEnded="OnVideoEnded" MediaFailed="OnVideoFailed"/></Border>
     <WrapPanel Grid.Row="2" Margin="0,20,0,0"><Button Click="OnPlayVideo" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"><TextBlock Text="{loc:Tr video.play}" Foreground="White"/></Button><Button Content="{loc:Tr video.open}" Click="OnOpenVideo" Margin="0,0,10,8"/><Button Content="{loc:Tr video.export}" Click="OnExportVideo" Margin="0,0,10,8"/><Button Content="{loc:Tr action.rename}" Click="OnRename" Margin="0,0,10,8"/><Button Content="{loc:Tr video.favorite}" Click="OnFavorite" Margin="0,0,10,8"/><Button Content="{loc:Tr video.trash}" Click="OnTrash" Margin="0,0,10,8"/><Button Content="{loc:Tr action.home}" Click="OnHome" Margin="0,0,10,8"/></WrapPanel>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource ChromeBrush}"><Grid Margin="17,0"><TextBlock x:Name="StatusLabel" Text="{loc:Tr status.ready}" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,260,0"/><TextBlock Text="{loc:Tr shortcut.regionHint}" Style="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  <Border x:Name="DialogBackdrop" Grid.RowSpan="4" Background="#600F172A" Visibility="Collapsed"/>
 </Grid>
</Window>
