<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../assets/SuniCapture.ico</ApplicationIcon>
    <AssemblyName>SuniCapture</AssemblyName>
    <RootNamespace>SuniCapture</RootNamespace>
    <Version>0.4.0</Version>
    <Company>Suniworks</Company>
    <Authors>lmdanavanem</Authors>
    <RepositoryUrl>https://github.com/lmdanavanem/SuniCapture</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Deterministic>true</Deterministic>
    <Product>SuniCapture</Product>
    <Description>Capture, annotate and organize your screen captures locally.</Description>
    <PlatformTarget>x64</PlatformTarget>
    <Platform>x64</Platform>
    <!-- WPF owns PerMonitorV2 through its manifest; WinForms is used only for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization/strings.json" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <Resource Include="../../assets/Brand/sunicapture-logo.png" Link="Brand/sunicapture-logo.png" />
    <Resource Include="../../assets/Brand/sunicapture-icon.png" Link="Brand/sunicapture-icon.png" />
    <Resource Include="../../assets/SuniCapture.ico" Link="Brand/SuniCapture.ico" />
  </ItemGroup>
</Project>
